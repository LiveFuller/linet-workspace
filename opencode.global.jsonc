{
  "$schema": "https://opencode.ai/config.json",
  "shell": "powershell",
  "default_agent": "prime",
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "permission": "allow",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-free": { "name": "GLM 5.3 (free)" },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": { "name": "Nemotron 3 Nano (free)" },
        "z-ai/glm-5.3": { "name": "GLM 5.3" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash" },
        "moonshotai/kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "minimax/minimax-m2.7": { "name": "MiniMax M2.7" },
        "google/gemini-3.7-flash": { "name": "Gemini 3.7 Flash" },
        "google/gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro" },
        "openai/gpt-5.6-luna": { "name": "GPT-5.6 Luna" },
        "openai/gpt-5.4-mini": { "name": "GPT-5.4 Mini" },
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "anthropic/claude-haiku-4.5": { "name": "Claude Haiku 4.5" }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "small_model": "tokenrouter/z-ai/glm-5.3-flash"
}
