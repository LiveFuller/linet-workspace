{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "prime",
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": { "*": "allow" },
    "task": "allow",
    "external_directory": { "*": "allow" },
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": { "*": "allow" }
      }
    }
  }
}
