# LINET Workspace — environment configuration
# Copy to .env (never commit .env). Demo mode works with NO variables set at all.

# ---------------------------------------------------------------------------
# Data mode: "local" (default) or "supabase".
# local    → fully offline demo workspace stored in this browser (IndexedDB).
# supabase → live mode against an authorized Supabase project. Requires the
#            variables below; the app will show a configuration screen when
#            they are missing or invalid, and will NEVER fall back to demo data.
# ---------------------------------------------------------------------------
VITE_DATA_MODE=local

# ---------------------------------------------------------------------------
# Supabase (live mode only) — PUBLIC values, safe for the browser bundle.
# Supabase "anon"/publishable keys are not secrets, but they do NOT replace RLS.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-authorized-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Microsoft 365 (optional, live mode only).
# Only the Entra client (application) ID is public. Client secrets are
# SERVER-ONLY and must NEVER be placed in this file or the frontend bundle.
# Consent, tenant approval and redirect URIs are configured in Entra ID,
# documented in docs/INTEGRATIONS.md.
# ---------------------------------------------------------------------------
# VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_MS_TENANT_ID=common
# VITE_MS_REDIRECT_PATH=/integrations

# ---------------------------------------------------------------------------
# AI assistance (optional, live mode only).
# There is deliberately NO AI key here. AI calls run inside a server boundary
# (Supabase Edge Function) which holds its own secret. See docs/INTEGRATIONS.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — do NOT put these into the frontend bundle:
#   SUPABASE_SERVICE_ROLE_KEY   (server functions only)
#   Graph / mail / AI provider keys, SMTP credentials
# These belong in the deployment environment of the server functions, never in
# VITE_* variables.
# ---------------------------------------------------------------------------
